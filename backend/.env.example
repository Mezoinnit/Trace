# Backend environment configuration.
# Copy to .env (or export directly). Never commit real secrets.

# PostgreSQL (defaults match docker-compose.yml)
DATABASE_URL=jdbc:postgresql://localhost:5432/trace
DATABASE_USER=trace
DATABASE_PASSWORD=trace
DATABASE_MAX_POOL_SIZE=10

# HTTP API
PORT=8080

# Security (ADR-015)
# Required in production: generate with e.g. `openssl rand -base64 48`.
TRACE_ENV=
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Rate limiting
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_API_PER_MIN=120

# AI layer (Phase 10): local deterministic provider by default.
# Paid providers (gemini/openai) activate here once keys exist — optional.
AI_PROVIDER=local

# Scheduler / workers (Phase 8)
WORKER_CONCURRENCY=4
SCHEDULER_TICK_MS=5000

# Logging: set to logback-prod.xml for structured JSON output.
LOGBACK_CONFIGURATION_FILE=